# ============================================================
# Пример переменных окружения проекта (скопируй в .env и заполни)
# ============================================================

# ---- backend (Java / Spring Boot) ----
# Токен, которым CV-модуль подписывает POST /api/v1/incidents
INGEST_API_TOKEN=replace-with-a-local-secret
# Окно дедупликации событий по track_id (по умолчанию 30s)
#INGEST_DEDUPLICATION_WINDOW=30s
# Каталог со снапшотами и фото (по умолчанию ./data/media)
#MEDIA_DIRECTORY=./data/media
# Разрешённые origins пульта оператора (через запятую)
#CORS_ALLOWED_ORIGINS=http://localhost:5173
# Секрет БД PostgreSQL для профиля postgres
DATABASE_PASSWORD=replace-with-a-local-password
# Включить демо-хелпер POST /api/v1/demo/reset
DEMO_MODE=true

# ---- cv-service (Python) ----
# Базовый URL бэкенда (по умолчанию http://localhost:8080)
#PLAYGROUND_API_URL=http://localhost:8080
# Токен ingest для cv-service — тот же, что и у backend
#INGEST_API_TOKEN=replace-with-a-local-secret

# ---- operator-app (Flutter) ----
# Адрес API при сборке: flutter run --dart-define=API_BASE_URL=...
#API_BASE_URL=http://localhost:8080
