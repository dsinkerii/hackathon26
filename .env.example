# Copy to `.env` (the start scripts do this automatically) and change the
# secrets before sharing the stack with anyone.

# Host ports
WEB_PORT=5173
BACKEND_PORT=8086
CAMERA_PORT=8090

# Backend secrets. JWT_SECRET must be at least 32 characters; the bootstrap
# password must be at least 12 characters.
JWT_SECRET=local-development-jwt-secret-change-me-32
INGEST_API_TOKEN=local-ingest-token
INITIAL_ADMIN_USERNAME=playground
INITIAL_ADMIN_PASSWORD=playground-demo

# Only used when the web app talks to the API directly instead of through the
# nginx proxy on the same origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeded camera for `--profile demo`. The browser resolves this URL.
DEMO_CAMERA_NAME=Demo camera
DEMO_CAMERA_URL=http://localhost:8090/stream.mjpg
